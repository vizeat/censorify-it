{
  "name": "censorify-it",
  "version": "4.0.0",
  "description": "Censor unwanted URLs, emails and telephone numbers to prevent spam",
  "author": "vizeat",
  "homepage": "https://github.com/vizeat/censorify-it",
  "bugs": {
    "url": "https://github.com/vizeat/censorify-it/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vizeat/censorify-it.git"
  },
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/censorify-it.cjs",
  "module": "./dist/censorify-it.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/censorify-it.js",
      "require": "./dist/censorify-it.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/linkify-it": "^5.0.0",
    "linkify-it": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@eatwith/commitlint-config-conventional": "^1.0.0",
    "@microsoft/api-extractor": "^7.59.3",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5",
    "eslint": "^10.8.0",
    "eslint-config-vizeat": "^13.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17",
    "prettier": "^3.9.6",
    "typescript": "^6",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5"
  },
  "scripts": {
    "build": "vite build",
    "check-build": "tsc -p . --noEmit",
    "coverage": "vitest run --coverage",
    "fmt": "eslint -c ./eslint.config.js --fix .",
    "lint": "eslint --cache -c ./eslint.config.js .",
    "prepare": "husky",
    "pub": "yarn build && yarn publish && git push --follow-tags",
    "test": "vitest",
    "watch": "vite build --watch"
  }
}
